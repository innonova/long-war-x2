// Long War 1.0's research (features/lw-research.md), generated by scripts/research-config.mjs from
// the Long War Tech Tree's rules and Long War's DefaultGameCore.ini: each tech's requirements, time
// and costs, the research credits, the starting staff, the labs' bonus.
class LWResearchRules extends Object config(LWResearch);

struct LWTechDef
{
	var int Id;
	var name Enum;
	var array<int> Requires;
	var array<int> AnyOf;
	var int Days;
	var int Alloys;
	var int Elerium;
	var int Fragments;
	var int Items;
	var array<int> Credits;
	var int GrantsCredit;
	/** The item that must have been held (and that Items counts, consumed). */
	var name EverHad;
	/** Items of which one must be in stores. */
	var array<name> InStores;
	/** A UFO type that must have been captured (a crash site or landed UFO of it taken). */
	var int CapturedUfo;
	var string Image;
};

struct LWCreditShare
{
	var int Credit;
	var int Percent;
};

var config int PointsPerDay;
var config int StartingScientists;
var config int StartingEngineers;
var config float LabBonus;
var config array<LWCreditShare> CreditShare;
var config array<LWTechDef> Techs;

/** The mod's tech template for a Long War tech: LWTech_ and the enum's name; Long War's own techs (eTech_Placeholder…) LWTech_ and the id (lw-words.mjs techTemplate). */
static function name TemplateFor(LWTechDef T)
{
	if (InStr(string(T.Enum), "Placeholder") != INDEX_NONE)
		return name("LWTech_" $ T.Id);
	return name("LWTech_" $ Mid(string(T.Enum), 6));
}

static function bool TechById(int Id, out LWTechDef T)
{
	local int k;

	k = default.Techs.Find('Id', Id);
	if (k == INDEX_NONE)
		return false;
	T = default.Techs[k];
	return true;
}

static function name TemplateForId(int Id)
{
	local LWTechDef T;

	return TechById(Id, T) ? TemplateFor(T) : '';
}

/** The share (0..1) research credits take off a tech: each held credit that covers it, stacking by multiplying (XGTechTree.GetCreditAdjustedTechHours). */
static function float CreditCut(LWTechDef T, array<int> Held)
{
	local float Left;
	local int c, k;

	Left = 1.0;
	foreach Held(c)
	{
		if (T.Credits.Find(c) == INDEX_NONE && c != 9)
			continue;
		k = default.CreditShare.Find('Credit', c);
		if (k != INDEX_NONE)
			Left *= 1.0 - default.CreditShare[k].Percent / 100.0;
	}
	return 1.0 - Left;
}
