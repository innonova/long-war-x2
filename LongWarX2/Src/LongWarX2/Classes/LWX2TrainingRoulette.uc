// Training Roulette (second wave #4; features/lw-second-wave.md): Long War's XGStrategySoldier.AssignRandomPerks. As a
// soldier of one of Long War's eight classes gets the class (not a MEC's), every perk in its tree that is one of Long War's
// RandomPerks is dealt again at random from them, none twice in the tree; the other perks stay where they are. (Long War
// also gives no perk-choice stat bonuses then: LWX2PerkBonuses, LWX2StatGains.) Generated by scripts/classes-config.mjs.
class LWX2TrainingRoulette extends Object config(LWClasses);

var config array<name> Classes;
var config array<SoldierClassAbilityType> Perks;

/** The unit's tree dealt (just given its class, in a game state of its own). False when the option or the class says no. */
static function bool Deal(XComGameState_Unit Unit)
{
	local array<name> Used;
	local array<SoldierClassAbilityType> Free;
	local SoldierClassAbilityType A;
	local int r, j, k;
	local bool bChanged;

	if (!class'LWX2SecondWave'.static.On(4) || default.Classes.Find(Unit.GetSoldierClassTemplateName()) == INDEX_NONE)
		return false;
	// (Long War's fixed perks count as taken too.)
	for (r = 0; r < Unit.AbilityTree.Length; r++)
		for (j = 0; j < Unit.AbilityTree[r].Abilities.Length; j++)
			if (default.Perks.Find('AbilityName', Unit.AbilityTree[r].Abilities[j].AbilityName) == INDEX_NONE)
				Used.AddItem(Unit.AbilityTree[r].Abilities[j].AbilityName);
	// The squaddie rank is bought as the class is given: kept (no class's squaddie perk is one of them).
	for (r = 1; r < Unit.AbilityTree.Length; r++)
	{
		for (j = 0; j < Unit.AbilityTree[r].Abilities.Length; j++)
		{
			if (default.Perks.Find('AbilityName', Unit.AbilityTree[r].Abilities[j].AbilityName) == INDEX_NONE)
				continue;
			Free.Length = 0;
			foreach default.Perks(A)
				if (Used.Find(A.AbilityName) == INDEX_NONE)
					Free.AddItem(A);
			if (Free.Length == 0)
				continue;
			k = `SYNC_RAND_STATIC(Free.Length);
			Unit.AbilityTree[r].Abilities[j] = Free[k];
			Used.AddItem(Free[k].AbilityName);
			bChanged = true;
		}
	}
	return bChanged;
}
