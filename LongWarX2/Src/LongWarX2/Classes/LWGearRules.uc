// Long War 1.0's soldier weapons (features/lw-gear.md), generated by scripts/gear-config.mjs from Long
// War's DefaultGameCore.ini and scripts/lw-gear.mjs: each weapon's numbers, who may carry it (its XCOM 2
// category), slot, kind of shot, look and tech, and whether it is the starting kit. And what engineering
// builds (Builds): each item's cost, days, engineers and what it needs first. And the armours (Armors), and
// the Foundry's projects (Foundry).
class LWGearRules extends Object config(LWGear);

struct LWWeaponDef
{
	var int Item;
	var name Enum;
	var name Family;
	var name Tier;
	var int Damage;
	var int Crit;
	var int Aim;
	var int Ammo;
	/** The clip with the Foundry's Ammo Conservation done (Long War's iSuppression keeps both: xxyy, xx with it). */
	var int AmmoConserved;
	var int Environment;
	var name Category;
	var EInventorySlot Slot;
	/** Rifle, Sniper (moving or shooting: XCOM 2's sniper shots) or Pistol. */
	var name Kind;
	/** The XCOM 2 weapon whose model, attachments, images and sounds it takes. */
	var name Look;
	var name Tech;
	/** XCOM 2's range table: SHORT, MEDIUM, LONG. */
	var name Range;
	var bool Infinite;
};

/** A Long War soldier armour (its Armors= line). */
struct LWArmorDef
{
	var int Item;
	var name Enum;
	var int HP;
	var int Defense;
	var int Will;
	var int Mobility;
	var int SmallItems;
	/** The XCOM 2 armour whose body parts, images and sounds it takes. */
	var name Look;
	var bool Grapple;
	var bool FireImmune;
	var bool PoisonImmune;
	var bool Infinite;
};

/** An item engineering builds (Long War's ItemBalance_Normal and XGItemTree.BuildItems). */
struct LWBuildDef
{
	/** Long War's item number. */
	var int Item;
	/** The XCOM 2 item built. */
	var name Template;
	var int Cash;
	var int Elerium;
	var int Alloys;
	var int Meld;
	/** A unit is Days x Engineers x 24 hours of work (XGItemTree.GetItemBuildTime): Days at Engineers. */
	var int Days;
	var int Engineers;
	/** The Long War tech researched first (its id; 0: none). */
	var int Tech;
	/** An item consumed per item built: ItemReqCount of it (0: one); and a second, ItemReq2Count of it. */
	var name ItemReq;
	var int ItemReqCount;
	var name ItemReq2;
	var int ItemReq2Count;
	/** The Foundry project done first (0: none). */
	var int Foundry;
};

/** A small item or the Rocketeer's launcher (features/lw-gear.md, phase 5; lw-gear.mjs SMALL). */
struct LWSmallDef
{
	var int Item;
	var name Template;
	var name Enum;
	/** Grenade, Medikit, Launcher, Rocket, Passive. */
	var name Kind;
	/** The XCOM 2 item whose abilities, effects and look it takes. */
	var name Look;
	var int Damage;
	var int Environment;
	/** In tiles. */
	var int Radius;
	var int Range;
	var int Aim;
	var int Crit;
	var int HP;
	/** Shots x this (Hi-Cap and Drum Mags: a shot costs a half, a third of the ammo). */
	var int Ammo;
	var int Pierce;
	/** Reaction shots' crit chance taken off its wearer (the Chameleon Suit). */
	var int CritAgainstReaction;
	/** Crit while carried once the Foundry's S.C.O.P.E. project is done (not with a pistol). */
	var int ScopeCrit;
	var bool Infinite;
	/** The classes that may carry it; empty: any. */
	var array<name> Classes;
};

/** A Foundry project (Long War's FoundryBalance, its requirements from XGTechTree.HasFoundryPrereqs). */
struct LWFoundryDef
{
	var int Id;
	/** Long War's EFoundryTech name (none past 24: those reuse other enums' numbers). */
	var name Enum;
	var int Days;
	var int Engineers;
	var int Cash;
	var int Elerium;
	var int Alloys;
	var int Fragments;
	var int Meld;
	/** The Long War tech researched first (its id). */
	var int Tech;
	/** An item that must be in stores, Items of it consumed. */
	var name Item;
	var int Items;
	/** An item that must have been held (asked as held now). */
	var name EverHad;
	/** The research credits that cut its time. */
	var array<int> Credits;
};

var config array<LWWeaponDef> Weapons;
var config array<LWSmallDef> SmallItems;
var config array<LWFoundryDef> Foundry;
var config array<LWArmorDef> Armors;
/** What a Long War soldier wears unless given another (Long War's item number). */
var config int StartingArmor;
var config array<LWBuildDef> Builds;
/** How a project's engineers make its work an hour (GetWorkPerHour: Long War's ABDUCTION_REWARD_ENG). */
var config float EngineerRate;
/** Long War's ITEM_TIME_BALANCE. */
var config float TimeBalance;
/** A workshop's cut of an item's cash cost, % (ScaleCost: WORKSHOP_ENG_BONUS). */
var config int WorkshopBonus;

/** The mod's template for a Long War weapon (lw-gear.mjs weaponTemplate). */
static function name TemplateFor(int Item)
{
	return name("LWWeapon_" $ Item);
}

/** The mod's template for a Long War armour (lw-gear.mjs armourTemplate). */
static function name ArmorTemplateFor(int Item)
{
	return name("LWArmor_" $ Item);
}

static function bool BuildFor(int Item, out LWBuildDef B)
{
	local int k;

	k = default.Builds.Find('Item', Item);
	if (k == INDEX_NONE)
		return false;
	B = default.Builds[k];
	return true;
}

static function bool FoundryFor(int Id, out LWFoundryDef F)
{
	local int k;

	k = default.Foundry.Find('Id', Id);
	if (k == INDEX_NONE)
		return false;
	F = default.Foundry[k];
	return true;
}

/** The template that carries a Foundry project's words (X2StrategyElement_LWTechs, never researchable). */
static function name FoundryTemplateFor(int Id)
{
	return name("LWFoundry_" $ Id);
}

static function bool SmallFor(name Template, out LWSmallDef D)
{
	local int k;

	k = default.SmallItems.Find('Template', Template);
	if (k == INDEX_NONE)
		return false;
	D = default.SmallItems[k];
	return true;
}
