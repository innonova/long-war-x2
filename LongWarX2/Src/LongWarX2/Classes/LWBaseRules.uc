// Long War 1.0's base (features/lw-base.md), generated by scripts/base-config.mjs from Long War's
// DefaultGameCore.ini and the Tree's data/itemtree.json: each facility's cost, days, power, upkeep,
// size and requirements, and the base's constants.
class LWBaseRules extends Object config(LWBase);

struct LWFacilityDef
{
	/** Long War's EFacilityType. */
	var int Id;
	var name Enum;
	/** -1: never built (the starting rooms). */
	var int Cash;
	var int Elerium;
	var int Alloys;
	var int Upkeep;
	var int Days;
	/** Made (+) or used (-). */
	var int Power;
	var int Size;
	var bool Multiple;
	/** The Long War tech researched first (its id; 0: none). */
	var int Tech;
	/** An item consumed, Items of it. */
	var name Item;
	var int Items;
};

var config array<LWFacilityDef> Facilities;

/** A psi power trained in the Psi Labs (features/lw-psi.md): Long War's numbers for it. */
struct LWPsiPower
{
	var int Perk;
	var name Enum;
	var int TargetWill;
	/** The Long War tech researched first (0: specially coded: Rift, after Mind Control). */
	var int Tech;
	var int Tier;
	/** Hours of fatigue after a mission (not applied yet). */
	var int Fatigue;
};
var config float PsiGiftChance;
var config int PsiTrainingHours;
var config int PsiSlots;
var config array<LWPsiPower> PsiPowers;

/** A gene mod made in the Genetics Lab (features/lw-genemods.md): Long War's numbers for it. */
struct LWGeneMod
{
	var int Perk;
	var name Enum;
	var int Cash;
	var int Tech;
	var int Meld;
	var int Days;
	var int Fatigue;
	/** Chest, Brain, Eyes, Skin or Legs: a soldier has one mod a slot (a string: as a name it shows another name's case). */
	var string Slot;
};
var config array<LWGeneMod> GeneMods;

var config array<int> BasePower;
var config int PowerAdjacencyBonus;
var config int SteamVents;
var config int LabMinimum;
var config int LabMultiple;
var config float LabAdjacencyBonus;
var config int WorkshopMinimum;
var config int WorkshopMultiple;
var config int WorkshopRebatePct;
var config int UplinkMultiple;
var config int NexusMultiple;
var config int UplinkCapacity;
var config int NexusCapacity;
var config int UplinkAdjacencyBonus;
var config int ExcavateCash;
var config int ExcavateDays;
var config int SkyrangerUpkeep;
var config int InterceptorUpkeep;
var config int OTSRank;
var config int InterceptorCost;
var config int RepairHours;
var config int RearmHours;
var config int TransferHours;
var config int OrderHours;
var config int HangarBays;
var config int FirestormUpkeep;

static function bool FacilityFor(int Id, out LWFacilityDef F)
{
	local int k;

	k = default.Facilities.Find('Id', Id);
	if (k == INDEX_NONE)
		return false;
	F = default.Facilities[k];
	return true;
}

/** The template that carries a facility's name (X2StrategyElement_LWTechs, never researchable). */
static function name FacilityTemplateFor(int Id)
{
	return name("LWFacility_" $ Id);
}

static function bool PsiPowerFor(int Perk, out LWPsiPower P)
{
	local int k;

	k = default.PsiPowers.Find('Perk', Perk);
	if (k == INDEX_NONE)
		return false;
	P = default.PsiPowers[k];
	return true;
}

/** Hours to train a power (XGFacility_PsiLabs.AddSoldier): PsiTrainingHours x its target will / the soldier's will. */
static function int PsiHours(int Will, LWPsiPower P)
{
	return default.PsiTrainingHours * P.TargetWill / Max(1, Will);
}

/** The chance (%) that training succeeds (XGFacility_PsiLabs.RollForGift; its council bonus left out). */
static function int PsiChance(int Will, LWPsiPower P)
{
	local int W, T, G;

	W = Max(1, Will);
	T = P.TargetWill;
	G = Round(100 * default.PsiGiftChance);
	if (W <= T + 80 - G)
		return Max(1, W - T + G);
	return Min(99, int(100 - 400.0 / float((W - T) + (G - 60))));
}

static function bool GeneModFor(int Perk, out LWGeneMod G)
{
	local int k;

	k = default.GeneMods.Find('Perk', Perk);
	if (k == INDEX_NONE)
		return false;
	G = default.GeneMods[k];
	return true;
}
