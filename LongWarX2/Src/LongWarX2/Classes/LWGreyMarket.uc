// Long War's grey market (features/lw-greymarket.md): XCOM sells what it holds for Long War's prices
// (XGItemTree.GetItemSalePrice: its ItemBalance_Normal cash, 40% for an item engineering builds; Xenological Remedies raises
// a corpse's), never craft, their weapons, the satellite or the Skyranger (CanBeSold), nor the alien grenade once the
// Foundry makes them (Alien Grenades). Generated by scripts/gear-config.mjs. An item sold before its research is done is
// marked NOT RESEARCHED, as EW's grey market marks it (XGGreyMarketUI.BuildItemProperties).
class LWGreyMarket extends Object config(LWGear);

struct LWSaleDef
{
	/** Long War's item number, the XCOM 2 item it is in the port, and Long War's price. */
	var int Item;
	var name Template;
	var int Cash;
	var bool Corpse;
};

var config array<LWSaleDef> Sales;

/** A sale's price for one, now (Xenological Remedies on corpses). */
static function int Price(int i)
{
	local int Cash, v;

	Cash = default.Sales[i].Cash;
	v = class'LWBonuses'.static.Has(class'LWBonuses'.const.XENOLOGICAL_REMEDIES);
	if (v > 0 && default.Sales[i].Corpse)
		Cash *= 1.0 + v / 100.0;
	return Cash;
}

/** Whether the grey market takes it (CanBeSold): the alien grenade only until the Foundry makes them. */
static function bool CanSell(int i)
{
	if (default.Sales[i].Item == 84)
		return !class'X2Effect_LWFoundry'.static.Done(2);
	return true;
}

/** How many XCOM could sell: what it holds (none of an item it holds without limit). */
static function int Available(int i)
{
	if (class'LWEngineering'.static.IsInfinite(default.Sales[i].Template))
		return 0;
	return class'LWEngineering'.static.Held(default.Sales[i].Template);
}

/** The sales XCOM has something for, in Long War's item order. */
static function array<int> Offered()
{
	local array<int> Out;
	local int i;

	for (i = 0; i < default.Sales.Length; i++)
		if (Available(i) > 0)
			Out.AddItem(i);
	return Out;
}

/** The research an item leads to is not done yet (the tech that needs it held: EverHad). */
static function bool NotResearched(int i)
{
	local LWResearchRules.LWTechDef T;
	local name Template;

	foreach class'LWResearchRules'.default.Techs(T)
	{
		if (T.EverHad != default.Sales[i].Template)
			continue;
		Template = class'LWResearchRules'.static.TemplateFor(T);
		return Template != '' && !class'UIUtilities_Strategy'.static.GetXComHQ().IsTechResearched(Template);
	}
	return false;
}

/** The items sold (sale indexes and how many of each): taken from the stores, their price paid. False if any is short. */
static function bool Sell(array<int> Which, array<int> Counts, out string Why)
{
	local XComGameState NewGameState;
	local XComGameState_HeadquartersXCom XComHQ;
	local int i, Total, Items;

	for (i = 0; i < Which.Length; i++)
	{
		if (Counts[i] <= 0)
			continue;
		if (!CanSell(Which[i]) || Available(Which[i]) < Counts[i])
		{
			Why = "Not enough" @ class'LWEngineering'.static.ItemName(default.Sales[Which[i]].Template) @ "to sell.";
			return false;
		}
		Total += Price(Which[i]) * Counts[i];
		Items += Counts[i];
	}
	if (Items == 0)
	{
		Why = "Nothing to sell.";
		return false;
	}
	NewGameState = class'XComGameStateContext_ChangeContainer'.static.CreateChangeState("Long War X2: the grey market");
	for (i = 0; i < Which.Length; i++)
		if (Counts[i] > 0)
			class'LWEngineering'.static.Take(NewGameState, default.Sales[Which[i]].Template, Counts[i]);
	XComHQ = XComGameState_HeadquartersXCom(NewGameState.ModifyStateObject(class'XComGameState_HeadquartersXCom', class'UIUtilities_Strategy'.static.GetXComHQ().ObjectID));
	XComHQ.AddResource(NewGameState, 'Supplies', Total);
	if (class'XComGameState_LWStrategy'.static.Get() != none)
		XComGameState_LWStrategy(NewGameState.ModifyStateObject(class'XComGameState_LWStrategy', class'XComGameState_LWStrategy'.static.Get().ObjectID)).Note("The grey market bought" @ Items @ (Items == 1 ? "item" : "items") @ "for" @ class'LWStrategyRules'.static.Money(Total) $ ".");
	`XCOMGAME.GameRuleset.SubmitGameState(NewGameState);
	`log("LongWarX2: grey market:" @ Items @ "items sold for" @ Total, , 'LongWarX2');
	Why = "";
	return true;
}
