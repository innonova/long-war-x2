// An Enemy Within map's geometry placed in XCOM 2 (features/hard-parts.md, experiment 2):
// its static meshes, from the map's package converted on the player's machine
// (tools/convert/ew-map.ts, which writes the map's LWX2EWMapData), spawned where EW placed
// them, around Origin. This class's config (XComLWEWMaps.ini, generated by scripts/maps-config.mjs) is
// the mod's own: Long War's maps per mission kind and the shared settings.
class LWX2EWMapPieces extends Object config(LWEWMaps);

/** A wall's fracture data (the plot writer's, ew-plot.ts; read here only so the line parses). */
struct LWX2PieceFrac
{
	var int Indices;
	var float MinZ, MaxZ;
	var name Toughness;
};

/** A piece's baked lighting from EW (features/ew-lightmaps.md): its colour and directional atlases, their scales, and its
 *  place in them (the lightmap UV = the mesh's UV set UV × scale + bias). */
struct LWX2PieceLightMap
{
	var string Color, Dir;
	var vector S0, S1;
	var float ScaleX, ScaleY, BiasX, BiasY;
	var int UV;
};

struct LWX2Piece
{
	var string Mesh;
	var vector Loc;
	var rotator Rot;
	var vector Scale;
	/** Its materials slot by slot (EW's meshes carry none XCOM 2 can read: the placed pieces and their archetypes do). */
	var array<string> Materials;
	/** The sky dome, the mountains: drawn, never colliding (they would enclose the map). */
	var bool Backdrop;
	/** A wall: its mesh is a FracturedStaticMesh (written by the converter for a map's own plot, ew-plot.ts). */
	var bool Fractured;
	/** Its cover flags where they differ from an XComLevelActor's (the plot sets them; read here only so the line parses). */
	var bool ClimbOnto, ClimbOver, Destination, IgnoreForCover;
	var name CoverForce;
	/** Seen through (EW's windows, foliage, cars) and windows: the plot sets them too. */
	var bool BlocksSight, Window;
	var LWX2PieceFrac Frac;
	var LWX2PieceLightMap LightMap;
};

/** A scalar parameter set on every stand-in (StandinScalars). */
struct LWX2Scalar
{
	var name Name;
	var float Value;
};

/** A texture parameter set on every stand-in (StandinTextures). */
struct LWX2TextureParam
{
	var name Name;
	var string Path;
};

/** An EW material's textures, for its XCOM 2 stand-in; Kind picks the parent. */
struct LWX2Look
{
	var string Material;
	var name Kind;
	var string Diffuse;
	var string Normal;
	/** For the cut-out kinds: the diffuse's alpha in green and blue, which XCOM 2's cut-out parents read (mask-textures.ts). */
	var string Mask;
	/** EW's glowing parts' colour (Kind Glow: light rings and strips, consoles' screens; HDR, above 1 brighter). */
	var LinearColor Tint;
	/** How often EW's material tiles its main texture (its MainTile_U: the base's cave rock twice); 0: once. */
	var float Tile;
};

struct LWX2Standin
{
	var string Material;
	var MaterialInterface Standin;
};

/**
 * XCOM 2 cannot draw EW's materials (their shaders are not in its caches and the game does
 * not compile them), so each is replaced by an instance of one of XCOM 2's parents, by its
 * kind, given the EW material's textures. Empty: the EW materials are kept.
 */
var config string PropParent;
/** The lightmapped stand-ins' parent (our own material, tools/materials: unlit, EW's diffuse × EW's baked lighting on the
 *  mesh's second UV set), and whether EW's base and EW's mission maps use it. "": not used. */
var config string LightmapParent;
/** EW's glowing parts (Kind Glow): an XCOM 2 parent that glows in one colour parameter, that parameter, the colour where
 *  EW takes it from the mesh's vertices, and a scale on EW's colours. */
var config string GlowParent;
/** EW's light cards (Kind Glow, by material path): our additive material that takes the mesh's vertex colours. */
var config string LightCardParent;
/** EW's emitters' stand-in materials (features/ew-emitters.md): blended and additive, our own (SDK editor). */
var config string ParticleParent, ParticleAddParent;
/** How opaque EW's blended sprites draw on ours (their opacity scaled: OpacityScale), and its additive ones. */
var config float ParticleOpacity, ParticleAddOpacity;
/** The draw distance of EW's emitters that set none (EW's others: 6000). */
var config float EmitterMaxDraw;
/** EW's lens flares' stand-in material (additive, ours) and how strong. */
var config string FlareParent;
var config float FlareOpacity;

var config array<string> LightCardMaterials;
var config float LightCardScale;
/** Its opacity where the parent has one (our glass: the cards as faint panes when the mesh's vertex colours do not reach). */
var config float LightCardOpacity;
var config name GlowColorParam;
var config LinearColor GlowDefault;
var config float GlowScale;
var config bool LightmapBase, LightmapMaps;
/** EW's baked lighting at this brightness (1: as stored). */
var config float LightmapBrightness;
var config string FoliageParent;
/** The parent for EW's cut-out materials (tree cards, signs, fences, road paint), given the look's mask as its Masks. */
var config string MaskedParent;
/** EW materials given another texture than the one the converter found (by the material's path in the converted level):
 *  the base's hologlobe takes EW's holographic earth in EW's teal, which the setup makes for the Situation Room
 *  (tools/convert/ew-earth.ts), where its own copy is EW's raw channels. */
struct LWX2LookOverride
{
	var string Material;
	var string Diffuse;
	/** An object of the package the texture is in, loaded first (the package is loaded with it). */
	var string Load;
	/** Its glow's colour, where it should differ from UnlitTint (the Situation Room's wall map, brighter than the globe). */
	var LinearColor Tint;
};
var config array<LWX2LookOverride> LookOverrides;
var config string AlienParent;
/** Scalars set on every stand-in (SpecularScale 0: the parents' placeholder mask made EW's surfaces glossy and grey). */
var config array<LWX2Scalar> StandinScalars;
/** Textures set on every stand-in (Masks white: the parents' own value for "no mask"; their placeholder darkened everything). */
var config array<LWX2TextureParam> StandinTextures;
/**
 * EW materials no stand-in can be made from (no diffuse map found), as the plot writer treats them (ew-plot.ts): by a part
 * of their name, case aside. Skipped: not drawn (markers, skies, decal-like effects an opaque stand-in draws as slabs); a
 * piece whose materials are all skipped is not placed. Glass: a translucent pane. Black (the name ending so): black.
 * Anything else: plain grey (GreyTint). Before, EW's own material was kept, which XCOM 2 draws as its checkerboard.
 */
var config array<string> SkipMaterials;
/** In EW's base only: materials EW draws opaque and black there (DoNothing, no colour input: the cutaway's cut surfaces
 *  between the rooms and floors, ew-compare), drawn so (our lightmap material at no light) rather than skipped. */
var config array<string> BaseBlackMaterials;
/** EW materials drawn unlit with their own diffuse, glowing in a colour (the base's hologlobe: EW's holographic earth). */
var config array<string> UnlitMaterials;
var config LinearColor UnlitTint;
var config array<string> GlassMaterials;
var config string GlassParent;
var config float GlassOpacity;
/** EW's base's glass panes placed; off: left out. */
var config bool BaseGlass;
/** Our own unlit translucent pane (LWX2Lightmap.M_EWGlass: Tint, Opacity) where GlassParent is not loaded, its colour and
 *  opacity. */
var config string GlassOwnParent;
var config LinearColor GlassTint;
var config float GlassOwnOpacity;
var config LinearColor GreyTint;
/** EW's alien pods (lw-missions.md, step 2): where its aliens stand, the commander's pod, how many. */
/** A place of EW's meld canisters (XComMeldContainerSpawnPoint; lw-loot.md): its drop zone's group, the turn it is gone, hard or easy. */
struct LWX2Meld
{
	var vector Loc;
	var int Group;
	var int Turns;
	var bool Hard;
};
struct LWX2Pod
{
	var vector Loc;
	var bool Commander;
	var int Min;
	var int Max;
	/** The sub-level it is in (Stream, EWI: the abduction variant, CNH); Abduction: the map's own abduction pods; none: the map's own. */
	var name Level;
};
/**
 * EW's lights (lw-missions.md, step 2): baked into its lightmaps, which XCOM 2 cannot use, so each is spawned as
 * a movable light. Kind: Point, Spot, Sun (its directional light), Sky. Unreal's units throughout.
 */
struct LWX2Light
{
	var name Kind;
	var vector Loc;
	var rotator Rot;
	var float Radius;
	var float Brightness;
	var color Color;
	var float Falloff;
	var float Inner;
	var float Outer;
	var float Lower;
};
/** EW's base (features/lw-base-view.md): a room location (XComHQ_RoomLocation, tagged R<row>_C<column>) and a camera
 *  (CameraActor, by its tag: the base's view, each tile's, each room's). */
struct LWX2Room
{
	var name Tag;
	var vector Loc;
};
/** One of EW's 3D UI panels (UIDisplay_LevelActor): its tag (the screens drawing on it name it), place and scale. */
struct LWX2Display
{
	/** EW's own panel mesh (its UVs take the screen's part of the movie); none: XCOM 2's plate (LWX2EWBase.DisplayMesh). */
	var string Mesh;
	var name Tag;
	var vector Loc;
	var rotator Rot;
	var vector Scale;
};

/** A material slot of one of EW's people: its textures, for XCOM 2's skeletal stand-in (LWX2EWBodies.MaterialParent). */
struct LWX2PersonSlot
{
	var string Diffuse, Normal;
	/** One of EW's unlit glowing materials (the Genetics Lab's tank glass): a glow in Tint. */
	var bool Glow;
	var LinearColor Tint;
};

/** One of EW's emitters (features/ew-emitters.md): its particle system, where it stands. */
struct LWX2Emitter
{
	var string Template;
	var vector Loc;
	var rotator Rot;
	var float Scale;
	/** How far away EW still draws it (its component's MaxDrawDistance); 0: always. */
	var float MaxDraw;
	/** How fast its time runs (its component's CustomTimeDilation: EW's slow steam 0.3); 0: as the world's. */
	var float Dilation;
};

/** One of a particle system's emitters' sprite: its texture, whether it adds, its sub-image grid. */
struct LWX2ParticleLook
{
	var string Template;
	var int Emitter;
	var string Texture;
	var bool Additive;
	var int SubX, SubY;
};

/** One of EW's lens flares (features/ew-emitters.md): its flare, where it stands. */
struct LWX2Flare
{
	var string Template;
	var vector Loc;
};

/** One of a lens flare's elements' texture: Element -1 its source, 0… its reflections. */
struct LWX2FlareLook
{
	var string Template;
	var int Element;
	var string Texture;
};

/** One of EW's people in its base (an Anim_ level's, features/ew-base-people.md). */
/** A key of an EW matinee's animation track: from Time on, the animation from From seconds to its length less End,
 *  forwards or (Reverse) backwards, held at that stretch's end. */
struct LWX2AnimKey
{
	var float Time, From, End;
	var bool Reverse;
};

struct LWX2Person
{
	var string Mesh;
	var vector Loc;
	var rotator Rot;
	var float Scale;
	/** Its matinee's first move key (features/ew-base-people.md: its frame not settled). */
	var vector Key;
	var array<string> AnimSets;
	var array<name> Seqs;
	var array<LWX2PersonSlot> Slots;
	/** Its component's physics asset (the Genetics Lab's canisters, whose animation carries them far from where they
	 *  stand): its bounds follow the bodies, so it is drawn where its animation takes it. */
	var string PhysicsAsset;
	/** Where in its loop EW's matinee has it at the matinee's start (seconds; before the loop's start, from its end), and
	 *  the looping matinee's play rate: the Genetics Lab's canisters, each at its place on the conveyor, at half speed.
	 *  0: a random start, the normal rate. */
	var float Start;
	var float Rate;
	/** The looping matinee's length: EW replays that much of the animation from Start, holding at its end, then starts
	 *  over (the canisters' base loop); 0: the animation itself loops. */
	var float Window;
	/** Its keys in that matinee (the canisters' steps along the belt and back); none: from Start on. */
	var array<LWX2AnimKey> Keys;
	/** EW's hangar bays (Anim_Hangar_LaunchBays, features/strategy-flow.md): a bay's (1-4) launch pad or craft for one of
	 *  its states (Open: a craft ready; Repair: a craft down; Closed: empty), its part (Track: the pad; Interceptor;
	 *  FireStorm); placed by the hangar's state, not with the level's people. */
	var int Bay;
	var string BayState;
	var name BayPart;
};

struct LWX2Camera
{
	var name Tag;
	var vector Loc;
	var rotator Rot;
	var float FOV;
};
/** Each light's brightness times this (EW's lightmaps added bounced light the movable lights do not). */
var config float LightScale;
/**
 * EW's atmosphere on an EW map's own plot (features/ew-lightmaps.md), its lightmaps on every piece: XCOM 2's environment's
 * sun, fog and the light of its environment map (its sky's blue on every lit surface) off, and EW's sun in place of XCOM
 * 2's. EW's dominant sun was never in its lightmaps (UE3 drew it live over them, with baked shadows), so it is placed:
 * its colour and direction, its brightness × EWSunScale (XCOM 2's light units are not EW's: by the light of EW's store
 * sidewalk, measured against EW). EnvAmbient: what is left of XCOM 2's environment map's diffuse and specular light.
 */
var config bool EWAtmosphere;
var config float EWSunScale;
var config float EnvAmbientDiffuse, EnvAmbientSpecular;
/** Which kinds are placed (the mission's own sun and sky light the map too). */
var config array<name> LightKinds;

/** One of Long War's maps for its missions (its DefaultMaps.ini): the kind (Abduction, Crash, Landed, Terror), the ship. */
struct LWX2MapChoice
{
	var string Name;
	var string Family;
	var name Kind;
	var int Ship;
	var bool Night;
	/** EXALT's covert missions: the streamed level with the mission (the map plays on LWX2V_<Level>). */
	var string Level;
};
var config array<LWX2MapChoice> Maps;
/** The converted map a quick launch places (no campaign to choose one). */
var config string DefaultMap;
/** For development: this converted map for every Long War mission, whatever its kind ("": Long War's list decides). */
var config string ForceMap;

/** The mission's converted EW map: a Long War mission's choice (XComGameState_LWStrategy.PendingEWMap, "" for none), else DefaultMap. */
static function string MapName()
{
	local XComGameState_LWStrategy S;
	local XComGameState_BattleData Battle;
	local WorldInfo W;

	// In a mission on an EW map's own plot (LWX2_<map>): that map, whatever started the mission (the campaign's first
	// mission is XCOM 2's, before Long War's Geoscape exists).
	W = class'WorldInfo'.static.GetWorldInfo();
	if (W != none && XComTacticalGRI(W.GRI) != none)
	{
		Battle = XComGameState_BattleData(`XCOMHISTORY.GetSingleGameStateObjectForClass(class'XComGameState_BattleData'));
		if (Battle != none && Left(Battle.MapData.PlotMapName, 5) ~= "LWX2_" && !(Battle.MapData.PlotMapName ~= "LWX2_EWPlotTemplate"))
			return Mid(Battle.MapData.PlotMapName, 5);
		// (LWX2V_<level>: a map with its council mission's variant level, ew-maps.ts writePlots.)
		if (Battle != none && Left(Battle.MapData.PlotMapName, 6) ~= "LWX2V_" && MapOfLevel(Mid(Battle.MapData.PlotMapName, 6)) != "")
			return MapOfLevel(Mid(Battle.MapData.PlotMapName, 6));
	}
	S = class'XComGameState_LWStrategy'.static.Get();
	return (S != none && S.PendingKind != 0) ? S.PendingEWMap : default.DefaultMap;
}

/** The mission's converted EW map's data (empty when there is none). */
static function LWX2EWMapData Map()
{
	local string Wanted;
	local LWX2EWMapData Data;

	// Made once per map and found again by its name (its config read once: a map's section is thousands of lines).
	Wanted = MapName() != "" ? MapName() : "LWX2NoMap";
	Data = LWX2EWMapData(FindObject("Transient." $ Wanted, class'LWX2EWMapData'));
	if (Data == none)
		Data = new(none, Wanted) class'LWX2EWMapData';
	return Data;
}

/** Whether this mission is played on a converted EW map: the switch on, and the mission's map converted on this machine. */
static function bool HasMap()
{
	return class'UIScreenListener_LongWarX2Tactical'.default.PlaceEWMapWhole && Map().Pieces.Length > 0;
}

/** Long War's map kind for the port's mission kind (1 crash site, 2 landed UFO, 3 abduction, 4 terror). */
/** The EW map of a variant level's plot (LWX2V_<level>): a council mission's, or an EXALT covert mission's. */
static function string MapOfLevel(string Level)
{
	local LWX2MapChoice M;

	if (class'LWCouncil'.static.MapOfLevel(Level) != "")
		return class'LWCouncil'.static.MapOfLevel(Level);
	foreach default.Maps(M)
		if (M.Level ~= Level)
			return M.Name;
	return "";
}

/** A map's variant level for a mission kind (EXALT's covert missions), "" for none. */
static function string LevelOf(string Map, name Kind)
{
	local LWX2MapChoice M;

	foreach default.Maps(M)
		if (M.Name ~= Map && M.Kind == Kind)
			return M.Level;
	return "";
}

/** EXALT's covert mission under way: an extraction or a data recovery (XComGameState_LWStrategy.ExaltMissionKind). */
static function name CovertKind()
{
	local XComGameState_LWStrategy S;

	S = class'XComGameState_LWStrategy'.static.Get();
	if (S != none && S.ExaltMissionKind == 2)
		return 'DataRecovery';
	return 'CovertExtraction';
}

static function name KindFor(int Kind)
{
	switch (Kind)
	{
		case 8: return CovertKind();
		case 1: return 'Crash';
		case 2: return 'Landed';
		case 3: return 'Abduction';
		case 4: return 'Terror';
		// The story's (features/lw-story.md): an alien base, the Temple Ship, the HQ assault, EXALT's base.
		case 5: return 'AlienBase';
		case 6: return 'Final';
		case 7: return 'HQAssault';
		case 9: return 'ExaltRaid';
	}
	return '';
}

/** The converted maps on this machine (their sections in XComLWX2EWMap.ini). */
static function array<string> ConvertedMaps()
{
	local array<string> Sections, Names;
	local string Section;

	GetPerObjectConfigSections(class'LWX2EWMapData', Sections);
	foreach Sections(Section)
		Names.AddItem(Left(Section, InStr(Section, " ")));
	return Names;
}

/**
 * A converted map for Long War's mission kind (and ship, for a crash or a landed UFO), at random among those Long War
 * lists for it; "" when this machine has none converted. A ship without a map of its own takes any of the kind.
 */
/**
 * Whether the mission is on the EW map's own plot (LWX2_<map>, written by tools/convert/ew-plot.ts): its geometry, lights
 * and spawns are in the plot, at EW's coordinates, and nothing is placed or hidden at run time.
 */
static function bool OnOwnPlot()
{
	local XComGameState_BattleData Battle;

	Battle = XComGameState_BattleData(`XCOMHISTORY.GetSingleGameStateObjectForClass(class'XComGameState_BattleData'));
	return Battle != none && MapName() != "" && (Battle.MapData.PlotMapName ~= ("LWX2_" $ MapName())
		|| (Left(Battle.MapData.PlotMapName, 6) ~= "LWX2V_" && MapOfLevel(Mid(Battle.MapData.PlotMapName, 6)) ~= MapName()));
}

static function string ChooseMap(name Kind, int Ship)
{
	local array<string> Converted, Fits, Any;
	local LWX2MapChoice M;

	Converted = ConvertedMaps();
	if (default.ForceMap != "" && Converted.Find(default.ForceMap) != INDEX_NONE)
		return default.ForceMap;
	foreach default.Maps(M)
	{
		if (M.Kind != Kind || Converted.Find(M.Name) == INDEX_NONE)
			continue;
		if (Any.Find(M.Name) == INDEX_NONE)
			Any.AddItem(M.Name);
		if ((Ship == 0 || M.Ship == Ship) && Fits.Find(M.Name) == INDEX_NONE)
			Fits.AddItem(M.Name);
	}
	if (Fits.Length > 0)
		return Fits[Rand(Fits.Length)];
	return Any.Length > 0 ? Any[Rand(Any.Length)] : "";
}

/** EW's atmosphere in place of XCOM 2's environment on an EW map's own plot (EWAtmosphere); a line for the log. */
static function string UseEWAtmosphere(Actor Spawner)
{
	local DirectionalLight DL;
	local X2EnvMapCaptureActor Cap;
	local ExponentialHeightFog Fog;
	local LWX2Light L;
	local LWX2SunLight Sun;
	local int Suns, Off;

	if (!default.EWAtmosphere || !OnOwnPlot())
		return "XCOM 2's environment kept";
	foreach Spawner.AllActors(class'DirectionalLight', DL)
	{
		if (LWX2SunLight(DL) != none || DL.LightComponent == none || !DL.LightComponent.bEnabled)
			continue;
		DL.LightComponent.SetEnabled(false);
		Off++;
	}
	foreach Spawner.AllActors(class'X2EnvMapCaptureActor', Cap)
	{
		if (Cap.EnvMapSceneCapture == none)
			continue;
		Cap.EnvMapSceneCapture.fDiffuseIntensity = default.EnvAmbientDiffuse;
		Cap.EnvMapSceneCapture.fSpecularIntensity = default.EnvAmbientSpecular;
		Cap.ReattachComponent(Cap.EnvMapSceneCapture);
	}
	foreach Spawner.AllActors(class'ExponentialHeightFog', Fog)
		if (Fog.Component != none)
			Fog.Component.SetEnabled(false);
	// (Placed once: a loaded battle comes here again.)
	foreach Spawner.AllActors(class'LWX2SunLight', Sun)
		Suns++;
	if (Suns == 0)
		foreach Map().Lights(L)
		{
			if (L.Kind != 'Sun')
				continue;
			Sun = Spawner.Spawn(class'LWX2SunLight', , , L.Loc, L.Rot);
			if (Sun == none || Sun.LightComponent == none)
				continue;
			Sun.LightComponent.SetLightProperties(L.Brightness * default.EWSunScale, L.Color);
			Sun.LightComponent.CastDynamicShadows = true;
			Sun.ReattachComponent(Sun.LightComponent);
			Suns++;
		}
	return "EW's atmosphere: XCOM 2's" @ Off @ "suns, fog and environment light off, EW's" @ Suns @ "sun(s) placed";
}

/** Spawns EW's lights (of LightKinds) moved by Shift; returns how many were placed. */
static function int PlaceLights(Actor Spawner, vector Shift)
{
	local array<Actor> Placed;

	return PlaceLightsOf(Map(), Spawner, Shift, Placed);
}

/** A converted map's lights (those of LightKinds), moved by Shift; returns how many, and adds them to Placed. */
/**
 * EW's emitters of a converted level (features/ew-emitters.md), where they stand, moved by Shift: EW's particle systems,
 * each emitter's material (EW's, which XCOM 2 cannot draw) replaced by an instance of our particle material
 * (ParticleParent, ParticleAddParent: made in the SDK editor) with the emitter's sprite. Returns how many.
 */
static function int PlaceEmittersOf(LWX2EWMapData D, Actor Spawner, vector Shift, out array<Actor> Placed)
{
	local LWX2Emitter E;
	local ParticleSystem PS;
	local EmitterSpawnable A;
	local int n;

	if (default.ParticleParent == "" || D == none)
		return 0;
	foreach D.Emitters(E)
	{
		PS = ParticleSystem(DynamicLoadObject(E.Template, class'ParticleSystem', true));
		if (PS == none || !ParticleStandins(D, E.Template, PS))
			continue;
		A = Spawner.Spawn(class'EmitterSpawnable', Spawner, , E.Loc + Shift, E.Rot);
		if (A == none)
			continue;
		A.SetDrawScale(E.Scale > 0 ? E.Scale : 1.0);
		A.SetTemplate(PS, false);
		// (Those without their own, the distance EW gives its others: in a room's view, not over the base's cutaway.)
		if (E.MaxDraw > 0 || default.EmitterMaxDraw > 0)
			A.ParticleSystemComponent.SetCullDistance(E.MaxDraw > 0 ? E.MaxDraw : default.EmitterMaxDraw);
		if (E.Dilation > 0)
			A.CustomTimeDilation = E.Dilation;
		A.ParticleSystemComponent.ActivateSystem();
		Placed.AddItem(A);
		n++;
	}
	return n;
}

/** A particle system's emitters given our materials, once (the system is shared by all its emitters); false if none of
 *  its sprites is known. */
static function bool ParticleStandins(LWX2EWMapData D, string Template, ParticleSystem PS)
{
	local LWX2ParticleLook L;
	local MaterialInstanceConstant MIC;
	local Material Parent;
	local Texture T;
	local int k, n;

	// (Done already: its first emitter's material is one of ours.)
	if (PS.Emitters.Length > 0 && PS.Emitters[0] != none && PS.Emitters[0].LODLevels.Length > 0 && PS.Emitters[0].LODLevels[0] != none
		&& PS.Emitters[0].LODLevels[0].RequiredModule != none && MaterialInstanceConstant(PS.Emitters[0].LODLevels[0].RequiredModule.Material) != none
		&& MaterialInstanceConstant(PS.Emitters[0].LODLevels[0].RequiredModule.Material).Parent != none
		&& InStr(PathName(MaterialInstanceConstant(PS.Emitters[0].LODLevels[0].RequiredModule.Material).Parent), "LWX2") != INDEX_NONE)
		return true;
	foreach D.ParticleLooks(L)
	{
		if (L.Template != Template || L.Emitter >= PS.Emitters.Length || PS.Emitters[L.Emitter] == none)
			continue;
		Parent = Material(DynamicLoadObject(L.Additive ? default.ParticleAddParent : default.ParticleParent, class'Material', true));
		T = Texture(DynamicLoadObject(L.Texture, class'Texture', true));
		if (Parent == none || T == none)
			continue;
		MIC = new(PS) class'MaterialInstanceConstant';
		MIC.SetParent(Parent);
		MIC.SetTextureParameterValue('Texture', T);
		MIC.SetScalarParameterValue('OpacityScale', L.Additive ? (default.ParticleAddOpacity > 0 ? default.ParticleAddOpacity : 1.0) : (default.ParticleOpacity > 0 ? default.ParticleOpacity : 1.0));
		for (k = 0; k < PS.Emitters[L.Emitter].LODLevels.Length; k++)
			if (PS.Emitters[L.Emitter].LODLevels[k] != none && PS.Emitters[L.Emitter].LODLevels[k].RequiredModule != none)
			{
				PS.Emitters[L.Emitter].LODLevels[k].RequiredModule.Material = MIC;
				// (A mesh emitter, EW's light cones: its mesh drawn with the emitter's material, ours, not the mesh's own.)
				if (ParticleModuleTypeDataMesh(PS.Emitters[L.Emitter].LODLevels[k].TypeDataModule) != none)
					ParticleModuleTypeDataMesh(PS.Emitters[L.Emitter].LODLevels[k].TypeDataModule).bOverrideMaterial = true;
			}
		n++;
	}
	return n > 0;
}

/**
 * EW's lens flares of a converted level (features/ew-emitters.md), moved by Shift: EW's flares, each element's material
 * (EW's, which XCOM 2 cannot draw) replaced by an instance of our flare material (FlareParent) with its texture.
 */
static function int PlaceFlaresOf(LWX2EWMapData D, Actor Spawner, vector Shift, out array<Actor> Placed)
{
	local LWX2Flare F;
	local LensFlare LF;
	local LWX2LensFlare A;
	local int n;

	if (default.FlareParent == "" || D == none)
		return 0;
	foreach D.Flares(F)
	{
		LF = LensFlare(DynamicLoadObject(F.Template, class'LensFlare', true));
		if (LF == none || !FlareStandins(D, F.Template, LF))
			continue;
		A = Spawner.Spawn(class'LWX2LensFlare', Spawner, , F.Loc + Shift);
		if (A == none)
			continue;
		A.SetTemplate(LF);
		Placed.AddItem(A);
		n++;
	}
	if (D.Flares.Length > 0)
		`log("LongWarX2: EW base:" @ n @ "of" @ D.Flares.Length @ "lens flares placed (" $ D.FlareLooks.Length @ "elements known)", , 'LongWarX2');
	return n;
}

/** A lens flare's elements given our material, once; false if none of its textures is known. */
static function bool FlareStandins(LWX2EWMapData D, string Template, LensFlare LF)
{
	local LWX2FlareLook L;
	local MaterialInstanceConstant MIC;
	local Material Parent;
	local Texture T;
	local int n;

	Parent = Material(DynamicLoadObject(default.FlareParent, class'Material', true));
	if (Parent == none)
		return false;
	if (LF.SourceElement.LFMaterials.Length > 0 && MaterialInstanceConstant(LF.SourceElement.LFMaterials[0]) != none
		&& MaterialInstanceConstant(LF.SourceElement.LFMaterials[0]).Parent == Parent)
		return true;
	foreach D.FlareLooks(L)
	{
		if (L.Template != Template || L.Element >= LF.Reflections.Length)
			continue;
		T = Texture(DynamicLoadObject(L.Texture, class'Texture', true));
		if (T == none)
			continue;
		MIC = new(LF) class'MaterialInstanceConstant';
		MIC.SetParent(Parent);
		MIC.SetTextureParameterValue('Texture', T);
		MIC.SetScalarParameterValue('OpacityScale', default.FlareOpacity > 0 ? default.FlareOpacity : 1.0);
		if (L.Element < 0)
		{
			LF.SourceElement.LFMaterials.Length = 1;
			LF.SourceElement.LFMaterials[0] = MIC;
		}
		else
		{
			LF.Reflections[L.Element].LFMaterials.Length = 1;
			LF.Reflections[L.Element].LFMaterials[0] = MIC;
		}
		n++;
	}
	return n > 0;
}

static function int PlaceLightsOf(LWX2EWMapData D, Actor Spawner, vector Shift, out array<Actor> Placed, optional bool bNoShadows, optional float Scale, optional bool bNoSky)
{
	local LWX2Light L;
	local Light A;
	local int Count;

	foreach D.Lights(L)
	{
		if (default.LightKinds.Find(L.Kind) == INDEX_NONE)
			continue;
		// (bNoSky: EW's sky lights left out; spawned in XCOM 2's strategy world they lit EW's base saturated red at times.)
		if (bNoSky && L.Kind == 'Sky')
			continue;
		switch (L.Kind)
		{
			// (Without shadows, bNoShadows: EW baked its lights' shadows into lightmaps; hundreds of movable shadowing lights,
			// as in its base, are more than XCOM 2 draws, and which it draws changes.)
			case 'Point': A = Spawner.Spawn(bNoShadows ? class'LWX2BasePointLight' : class'LWX2PointLight', , , L.Loc + Shift, L.Rot); break;
			case 'Spot': A = Spawner.Spawn(bNoShadows ? class'LWX2BaseSpotLight' : class'LWX2SpotLight', , , L.Loc + Shift, L.Rot); break;
			case 'Sun': A = Spawner.Spawn(class'LWX2SunLight', , , L.Loc + Shift, L.Rot); break;
			case 'Sky': A = Spawner.Spawn(class'LWX2SkyLight', , , L.Loc + Shift, L.Rot); break;
			default: A = none;
		}
		if (A == none || A.LightComponent == none)
			continue;
		if (PointLightComponent(A.LightComponent) != none)
		{
			PointLightComponent(A.LightComponent).Radius = L.Radius;
			PointLightComponent(A.LightComponent).FalloffExponent = L.Falloff;
		}
		if (SpotLightComponent(A.LightComponent) != none)
		{
			SpotLightComponent(A.LightComponent).InnerConeAngle = L.Inner;
			SpotLightComponent(A.LightComponent).OuterConeAngle = L.Outer;
		}
		// (Scale: the caller's; else LightScale, for a map placed at run time.)
		A.LightComponent.SetLightProperties(L.Brightness * (Scale > 0 ? Scale : (default.LightScale > 0 ? default.LightScale : 1.0)), L.Color);
		A.ReattachComponent(A.LightComponent);
		Placed.AddItem(A);
		Count++;
	}
	`log("LongWarX2: EW map:" @ Count @ "of" @ D.Lights.Length @ "lights placed", , 'LongWarX2');
	return Count;
}

/** Spawns the pieces with their positions relative to Origin; returns how many were placed. */
static function int PlaceAll(Actor Spawner, vector Origin)
{
	local array<Actor> Placed;

	if (Map().Pieces.Length == 0)
		return 0;
	Place(Spawner, vect(0, 0, 0), 0, Origin, class'DynamicSMActor_Spawnable', Placed);
	return Placed.Length;
}

/**
 * Spawns the pieces within Radius of Center (all when Radius is 0), moved so Center lands
 * on At, as actors of the given class (a StaticMeshActor or a DynamicSMActor). With
 * bCollideInPlayOnly, pieces outside EW's play area (its backdrop) do not collide.
 */
static function Place(Actor Spawner, vector Center, float Radius, vector At, class<Actor> ActorClass, out array<Actor> Placed, optional bool bCollideInPlayOnly)
{
	PlaceOf(Map(), Spawner, Center, Radius, At, ActorClass, Placed, bCollideInPlayOnly);
}

/** Place for a given converted map (its package loaded first). */
static function PlaceOf(LWX2EWMapData D, Actor Spawner, vector Center, float Radius, vector At, class<Actor> ActorClass, out array<Actor> Placed, optional bool bCollideInPlayOnly, optional bool bDirectLight)
{
	local LWX2Piece P;
	local StaticMesh Mesh;
	local Actor A;
	local StaticMeshComponent Comp;
	local int Missing, i, Backdrop, Skipped;
	local array<LWX2Standin> Standins;
	local MaterialInterface M;

	if (D.MapPackage != "")
		DynamicLoadObject(D.MapPackage $ ".TheWorld", class'Object', true);
	foreach D.Pieces(P)
	{
		if (Radius > 0 && VSize2D(P.Loc - Center) > Radius)
			continue;
		if (AllSkipped(P, D, ClassIsChildOf(ActorClass, class'DynamicSMActor_Spawnable')))
		{
			Skipped++;
			continue;
		}
		Mesh = StaticMesh(DynamicLoadObject(P.Mesh, class'StaticMesh', true));
		if (Mesh == none)
		{
			if (Missing++ == 0)
				`log("LongWarX2: EW map: not found:" @ P.Mesh, , 'LongWarX2');
			continue;
		}
		A = Spawner.Spawn(ActorClass, , , At + P.Loc - Center, P.Rot);
		if (A == none)
			continue;
		if (DynamicSMActor(A) != none)
		{
			DynamicSMActor(A).SetStaticMesh(Mesh);
			Comp = DynamicSMActor(A).StaticMeshComponent;
			A.SetCollision(false, false);
			// Lit by the lights themselves (bDirectLight), not through the actor's light environment, which folds the
			// lights near it into one approximation as it is made and keeps it: EW's base, placed while the Avenger's sun was
			// on, kept that sun's colour of the hour (blue, purple, red, green from one campaign to the next).
			if (bDirectLight && DynamicSMActor(A).LightEnvironment != none)
			{
				DynamicSMActor(A).LightEnvironment.SetEnabled(false);
				Comp.SetLightEnvironment(none);
			}
		}
		else
		{
			Comp = StaticMeshActor(A).StaticMeshComponent;
			Comp.SetStaticMesh(Mesh);
		}
		A.SetDrawScale3D(P.Scale);
		// The backdrop does not collide: the huge pieces (the sky dome, the mountains: they would
		// enclose the map), and with bCollideInPlayOnly whatever is outside the play area.
		if (P.Backdrop || (bCollideInPlayOnly && (Abs(P.Loc.X - D.PlayCenter.X) > D.PlayExtent.X || Abs(P.Loc.Y - D.PlayCenter.Y) > D.PlayExtent.Y)))
		{
			A.SetCollision(false, false);
			Comp.SetBlockRigidBody(false);
			Comp.SetActorCollision(false, false);
			Comp.SetTraceBlocking(false, false); // the sky dome's collision box holds the whole map
			Backdrop++;
		}
		for (i = 0; i < P.Materials.Length; i++)
		{
			M = none;
			if (ClassIsChildOf(ActorClass, class'DynamicSMActor_Spawnable') && Matches(P.Materials[i], default.BaseBlackMaterials))
			{
				M = BlackStandin(A);
				// (Known as a cut surface: hidden while a facility's own camera looks in, LWX2EWBase.ShowCutaway.)
				A.Tag = 'LWX2BaseCutaway';
			}
			else if (P.LightMap.Color != "" && (ClassIsChildOf(ActorClass, class'DynamicSMActor_Spawnable') ? default.LightmapBase : default.LightmapMaps))
				M = Lightmapped(P, P.Materials[i], A, D);
			if (M == none)
				M = MaterialFor(P.Materials[i], A, Standins, D);
			if (M != none)
				Comp.SetMaterial(i, M);
		}
		Placed.AddItem(A);
	}
	`log("LongWarX2: EW map:" @ Placed.Length @ "pieces placed as" @ ActorClass.Name $ "," @ Missing @ "meshes not found;" @ Standins.Length @ "materials" $ ";" @ Backdrop @ "backdrop pieces without collision;" @ Skipped @ "skipped (markers, skies, decals)", , 'LongWarX2');
}

/**
 * A piece's own stand-in for one of its EW materials, lit by EW's baked lighting (features/ew-lightmaps.md): an instance of
 * LightmapParent with the material's diffuse and the piece's lightmap. None where that cannot be (no parent, an EW material
 * without a diffuse or of a see-through kind, the lightmap on another UV set, its atlases not found): the shared stand-in.
 */
static function MaterialInterface Lightmapped(LWX2Piece P, string Path, Object InOuter, LWX2EWMapData D)
{
	local MaterialInstanceConstant MIC;
	local Material Parent;
	local Texture Diffuse, LM;
	local LinearColor V;
	local float B;
	local int k;

	if (default.LightmapParent == "" || P.LightMap.UV != 1)
		return none;
	k = D.Looks.Find('Material', Path);
	if (k == INDEX_NONE || D.Looks[k].Kind != 'Prop' || D.Looks[k].Diffuse == "" || Matches(Path, default.GlassMaterials) || Matches(Path, default.UnlitMaterials))
		return none;
	Parent = Material(DynamicLoadObject(default.LightmapParent, class'Material', true));
	Diffuse = Texture(DynamicLoadObject(D.Looks[k].Diffuse, class'Texture', true));
	// (The colour atlas, combined with the directional one by the converter: tools/convert/lightmap-bake.ts.)
	LM = Texture(DynamicLoadObject(P.LightMap.Color, class'Texture', true));
	if (Parent == none || Diffuse == none || LM == none)
		return none;
	MIC = new(InOuter) class'MaterialInstanceConstant';
	MIC.SetParent(Parent);
	MIC.SetTextureParameterValue('Diffuse', Diffuse);
	if (D.Looks[k].Tile > 0)
		MIC.SetScalarParameterValue('DiffuseTile', D.Looks[k].Tile);
	MIC.SetTextureParameterValue('LightMap', LM);
	V.R = P.LightMap.ScaleX; V.G = P.LightMap.ScaleY; V.B = P.LightMap.BiasX; V.A = P.LightMap.BiasY;
	MIC.SetVectorParameterValue('LMScaleBias', V);
	// The piece's scales as one brightness: the colour's mean × the directions' mean × 3 (the atlas holds their mean)
	// × 1/sqrt(3) (each direction's weight for a surface facing out of its face).
	B = (P.LightMap.S0.X + P.LightMap.S0.Y + P.LightMap.S0.Z) / 3 * (P.LightMap.S1.X + P.LightMap.S1.Y + P.LightMap.S1.Z) / 3 * 1.732;
	MIC.SetScalarParameterValue('LMBrightness', B * (default.LightmapBrightness > 0 ? default.LightmapBrightness : 1.0));
	V.R = 1; V.G = 1; V.B = 1; V.A = 1;
	MIC.SetVectorParameterValue('Tint', V);
	return MIC;
}

/** Loads the converted map package (any of its objects loads it whole: then its meshes are found by their paths). */
static function LoadPackage()
{
	local Object Loaded;

	Loaded = DynamicLoadObject(Map().MapPackage $ ".TheWorld", class'Object', true);
	`log("LongWarX2: EW map: package" @ Map().MapPackage @ (Loaded != none ? "loaded" : "not loaded (its meshes may still be found)"), , 'LongWarX2');
}

/** XCOM 2's cover points within Radius of At (for the experiment's log). */
static function int CountCover(XComWorldData World, vector At, float Radius)
{
	local array<XComCoverPoint> Points;

	World.GetCoverPoints(At, Radius, 256, Points);
	return Points.Length;
}

/** Of the 7x7 tiles around At, how many units cannot enter (a solid hull blocks them). */
static function int CountBlocked(XComWorldData World, vector At)
{
	local TTile Centre, T;
	local int dx, dy, n;

	Centre = World.GetTileCoordinatesFromPosition(At);
	for (dx = -3; dx <= 3; dx++)
		for (dy = -3; dy <= 3; dy++)
		{
			T = Centre;
			T.X += dx;
			T.Y += dy;
			if (!World.CanUnitsEnterTile(T))
				n++;
		}
	return n;
}

/** Whether a part of the path, case aside, is one of these. */
static function bool Matches(string Path, array<string> Parts)
{
	local string P;

	foreach Parts(P)
		if (P != "" && InStr(Locs(Path), Locs(P)) != INDEX_NONE)
			return true;
	return false;
}

/** Whether every material of the piece is an EW material without a diffuse that is skipped (SkipMaterials). */
static function bool AllSkipped(LWX2Piece P, LWX2EWMapData D, optional bool bBase)
{
	local string M;
	local int k;

	if (P.Materials.Length == 0 || (default.SkipMaterials.Length == 0 && !(bBase && !default.BaseGlass)))
		return false;
	foreach P.Materials(M)
	{
		if (M == "")
			continue;
		k = D.Looks.Find('Material', M);
		// (EW's base's glass left out where BaseGlass is off: XCOM 2's translucent parent is not loaded in the strategy
		// layer, and EW's own pane then drew opaque and blue over the labs' windows.)
		if (bBase && !default.BaseGlass && k != INDEX_NONE && D.Looks[k].Diffuse == "" && Matches(M, default.GlassMaterials))
			continue;
		if (k == INDEX_NONE || D.Looks[k].Diffuse != "" || !Matches(M, default.SkipMaterials) || (bBase && Matches(M, default.BaseBlackMaterials)))
			return false;
	}
	return true;
}

/** The stand-in for an EW material without a diffuse: glass a translucent pane, black black, else plain grey. */
static function MaterialInterface PlainStandin(string Path, Object InOuter)
{
	local MaterialInstanceConstant MIC;
	local Material Parent;
	local Texture T;
	local LinearColor Tint;
	local bool bGlass;
	local int k;

	bGlass = Matches(Path, default.GlassMaterials) && default.GlassParent != "";
	Parent = Material(DynamicLoadObject(bGlass ? default.GlassParent : default.PropParent, class'Material', true));
	// (Glass where XCOM 2's translucent parent is not loaded, EW's base: our own pane, GlassOwnParent, in GlassTint at
	// GlassOwnOpacity; EW's own material had drawn opaque and blue.)
	if (Parent == none && bGlass && default.GlassOwnParent != "")
	{
		Parent = Material(DynamicLoadObject(default.GlassOwnParent, class'Material', true));
		if (Parent == none)
			return none;
		MIC = new(InOuter) class'MaterialInstanceConstant';
		MIC.SetParent(Parent);
		MIC.SetScalarParameterValue('Opacity', default.GlassOwnOpacity);
		MIC.SetVectorParameterValue('Tint', default.GlassTint);
		return MIC;
	}
	if (Parent == none)
		return none;
	MIC = new(InOuter) class'MaterialInstanceConstant';
	MIC.SetParent(Parent);
	T = Texture(DynamicLoadObject("EngineResources.WhiteSquareTexture", class'Texture', true));
	if (T != none)
		MIC.SetTextureParameterValue('Diffuse', T);
	if (bGlass)
	{
		MIC.SetScalarParameterValue('Opacity', default.GlassOpacity);
		MIC.SetScalarParameterValue('SpecularScale', 0.5);
		return MIC;
	}
	for (k = 0; k < default.StandinScalars.Length; k++)
		MIC.SetScalarParameterValue(default.StandinScalars[k].Name, default.StandinScalars[k].Value);
	for (k = 0; k < default.StandinTextures.Length; k++)
	{
		T = Texture(DynamicLoadObject(default.StandinTextures[k].Path, class'Texture', true));
		if (T != none)
			MIC.SetTextureParameterValue(default.StandinTextures[k].Name, T);
	}
	Tint = default.GreyTint;
	if (Right(Locs(Path), 5) == "black")
		Tint = MakeLinearColor(0, 0, 0, 1);
	MIC.SetVectorParameterValue('TintColor', Tint);
	return MIC;
}

/** A plain stand-in in a colour (the hologlobe's markers, LWX2EWBase). */
static function MaterialInterface TintedStandin(LinearColor Tint, Object InOuter)
{
	local MaterialInstanceConstant MIC;

	MIC = MaterialInstanceConstant(PlainStandin("", InOuter));
	if (MIC != none)
		MIC.SetVectorParameterValue('TintColor', Tint);
	return MIC;
}

/** The material a slot gets: the EW material's XCOM 2 stand-in, made once; the EW material itself when it has none. */
/** Unlit black: LightmapParent at no light. */
static function MaterialInterface BlackStandin(Object InOuter)
{
	local MaterialInstanceConstant MIC;
	local Material Parent;

	Parent = Material(DynamicLoadObject(default.LightmapParent, class'Material', true));
	if (Parent == none)
		return none;
	MIC = new(InOuter) class'MaterialInstanceConstant';
	MIC.SetParent(Parent);
	MIC.SetScalarParameterValue('LMBrightness', 0);
	return MIC;
}

/** A light card's stand-in: LightCardParent at LightCardScale (its colour and fade the mesh's vertex colours). */
static function MaterialInterface LightCardStandin(Object InOuter)
{
	local MaterialInstanceConstant MIC;
	local Material Parent;
	local LinearColor C;

	Parent = Material(DynamicLoadObject(default.LightCardParent, class'Material', true));
	if (Parent == none)
		return none;
	MIC = new(InOuter) class'MaterialInstanceConstant';
	MIC.SetParent(Parent);
	C = MakeLinearColor(default.LightCardScale, default.LightCardScale, default.LightCardScale, 1);
	MIC.SetVectorParameterValue('Tint', C);
	if (default.LightCardOpacity > 0)
		MIC.SetScalarParameterValue('Opacity', default.LightCardOpacity);
	return MIC;
}

/** A stand-in for one of EW's glowing parts: GlowParent in the look's colour (GlowDefault where EW colours it by vertex),
 *  over the screen's picture or plain white. */
static function MaterialInterface GlowStandin(LWX2Look L, Object InOuter, optional bool bKeepDiffuse)
{
	local MaterialInstanceConstant MIC;
	local Material Parent;
	local Texture T, White;
	local LinearColor C, SB;
	local bool bOurs;

	Parent = Material(DynamicLoadObject(default.GlowParent, class'Material', true));
	if (Parent == none)
		return none;
	// (Our own unlit material, as EW's glows are unlit: white, no lightmap, EW's colour as Tint.)
	bOurs = default.GlowParent == default.LightmapParent;
	MIC = new(InOuter) class'MaterialInstanceConstant';
	MIC.SetParent(Parent);
	White = Texture(DynamicLoadObject("EngineResources.WhiteSquareTexture", class'Texture', true));
	// (A console's screen in EW's tint alone: EW's picture there, HQscreens_test, is a green pattern EW's material reads
	// as a mask; multiplied by the tint, as ours does, it came out green.)
	// (Since converter 40 the converter whitens it, _LWX2White: tinted, EW's UI panels in EW's colour.)
	T = Texture(DynamicLoadObject((L.Diffuse != "" && (!bOurs || bKeepDiffuse || InStr(L.Diffuse, "_LWX2White") != INDEX_NONE)) ? L.Diffuse : "EngineResources.WhiteSquareTexture", class'Texture', true));
	if (T != none)
		MIC.SetTextureParameterValue('Diffuse', T);
	C = bKeepDiffuse ? ((L.Tint.R + L.Tint.G + L.Tint.B > 0) ? L.Tint : default.UnlitTint) : ((L.Tint.R + L.Tint.G + L.Tint.B > 0) ? L.Tint : default.GlowDefault);
	C.R *= default.GlowScale; C.G *= default.GlowScale; C.B *= default.GlowScale; C.A = 1;
	if (bOurs)
	{
		if (White != none)
			MIC.SetTextureParameterValue('LightMap', White);
		SB.R = 1; SB.G = 1; SB.B = 0; SB.A = 0;
		MIC.SetVectorParameterValue('LMScaleBias', SB);
		MIC.SetScalarParameterValue('LMBrightness', 1.0);
		MIC.SetVectorParameterValue('Tint', C);
	}
	else
		MIC.SetVectorParameterValue(default.GlowColorParam, C);
	return MIC;
}

static function MaterialInterface MaterialFor(string Path, Object InOuter, out array<LWX2Standin> Standins, optional LWX2EWMapData D)
{
	local int k, i;
	local LWX2Look L;
	local LWX2Standin S;
	local string ParentPath;
	local Material Parent;
	local MaterialInstanceConstant MIC;
	local Texture T;

	if (D == none)
		D = Map();
	if (Path == "")
		return none;
	k = Standins.Find('Material', Path);
	if (k != INDEX_NONE)
		return Standins[k].Standin;
	S.Material = Path;
	k = D.Looks.Find('Material', Path);
	if (k != INDEX_NONE)
	{
		L = D.Looks[k];
		i = default.LookOverrides.Find('Material', Path);
		if (i != INDEX_NONE)
		{
			if (default.LookOverrides[i].Load != "")
				DynamicLoadObject(default.LookOverrides[i].Load, class'Object', true);
			L.Diffuse = default.LookOverrides[i].Diffuse;
			L.Tint = default.LookOverrides[i].Tint;
		}
		ParentPath = L.Kind == 'Foliage' ? default.FoliageParent : (L.Kind == 'Alien' ? default.AlienParent : ((L.Kind == 'Masked' && default.MaskedParent != "") ? default.MaskedParent : default.PropParent));
	}
	if (k != INDEX_NONE && L.Diffuse != "" && default.GlowParent != "" && Matches(Path, default.UnlitMaterials))
	{
		S.Standin = GlowStandin(L, InOuter, true);
		if (S.Standin != none)
		{
			Standins.AddItem(S);
			return S.Standin;
		}
	}
	// (EW's light cards, coloured and faded by the mesh's own vertex colours: our additive card material, LightCardParent,
	// which reads them; the Genetics Lab's tanks' glow, the Psi Labs' lamps.)
	if (k != INDEX_NONE && L.Kind == 'Glow' && default.LightCardParent != "" && Matches(Path, default.LightCardMaterials))
	{
		S.Standin = LightCardStandin(InOuter);
		if (S.Standin != none)
		{
			Standins.AddItem(S);
			return S.Standin;
		}
	}
	if (k != INDEX_NONE && L.Kind == 'Glow' && default.GlowParent != "")
	{
		S.Standin = GlowStandin(L, InOuter);
		if (S.Standin != none)
		{
			Standins.AddItem(S);
			return S.Standin;
		}
	}
	if (k != INDEX_NONE && L.Diffuse == "" && default.PropParent != "" && !Matches(Path, default.SkipMaterials))
	{
		S.Standin = PlainStandin(Path, InOuter);
		if (S.Standin != none)
		{
			Standins.AddItem(S);
			return S.Standin;
		}
	}
	if (ParentPath != "" && L.Diffuse != "")
	{
		Parent = Material(DynamicLoadObject(ParentPath, class'Material', true));
		if (Parent == none)
			`log("LongWarX2: EW map: parent material" @ ParentPath @ "not loaded; the EW material kept for" @ Path, , 'LongWarX2');
	}
	if (Parent != none)
	{
		MIC = new(InOuter) class'MaterialInstanceConstant';
		MIC.SetParent(Parent);
		for (k = 0; k < default.StandinScalars.Length; k++)
			MIC.SetScalarParameterValue(default.StandinScalars[k].Name, default.StandinScalars[k].Value);
		for (k = 0; k < default.StandinTextures.Length; k++)
		{
			T = Texture(DynamicLoadObject(default.StandinTextures[k].Path, class'Texture', true));
			if (T != none)
				MIC.SetTextureParameterValue(default.StandinTextures[k].Name, T);
		}
		T = Texture(DynamicLoadObject(L.Diffuse, class'Texture', true));
		if (T != none)
			MIC.SetTextureParameterValue('Diffuse', T);
		if (L.Mask != "")
		{
			T = Texture(DynamicLoadObject(L.Mask, class'Texture', true));
			if (T != none)
				MIC.SetTextureParameterValue('Masks', T);
		}
		if (L.Normal != "")
		{
			T = Texture(DynamicLoadObject(L.Normal, class'Texture', true));
			if (T != none)
				MIC.SetTextureParameterValue('Normal', T);
		}
		S.Standin = MIC;
	}
	else
		S.Standin = MaterialInterface(DynamicLoadObject(Path, class'MaterialInterface', true));
	Standins.AddItem(S);
	return S.Standin;
}
