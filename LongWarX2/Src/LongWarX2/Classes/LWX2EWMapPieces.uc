// An Enemy Within map's geometry placed in XCOM 2 (features/hard-parts.md, experiment 2):
// its static meshes, from the map's package converted on the player's machine
// (tools/convert/ew-map.ts, which writes the map's LWX2EWMapData), spawned where EW placed
// them, around Origin. This class's config (XComLWEWMaps.ini, generated by scripts/maps-config.mjs) is
// the mod's own: Long War's maps per mission kind and the shared settings.
class LWX2EWMapPieces extends Object config(LWEWMaps);

/** A wall's fracture data (the plot writer's, ew-plot.ts; read here only so the line parses). */
struct LWX2PieceFrac
{
	var int Indices;
	var float MinZ, MaxZ;
	var name Toughness;
};

struct LWX2Piece
{
	var string Mesh;
	var vector Loc;
	var rotator Rot;
	var vector Scale;
	/** Its materials slot by slot (EW's meshes carry none XCOM 2 can read: the placed pieces and their archetypes do). */
	var array<string> Materials;
	/** The sky dome, the mountains: drawn, never colliding (they would enclose the map). */
	var bool Backdrop;
	/** A wall: its mesh is a FracturedStaticMesh (written by the converter for a map's own plot, ew-plot.ts). */
	var bool Fractured;
	/** Its cover flags where they differ from an XComLevelActor's (the plot sets them; read here only so the line parses). */
	var bool ClimbOnto, ClimbOver, Destination, IgnoreForCover;
	var name CoverForce;
	/** Seen through (EW's windows, foliage, cars) and windows: the plot sets them too. */
	var bool BlocksSight, Window;
	var LWX2PieceFrac Frac;
};

/** A scalar parameter set on every stand-in (StandinScalars). */
struct LWX2Scalar
{
	var name Name;
	var float Value;
};

/** A texture parameter set on every stand-in (StandinTextures). */
struct LWX2TextureParam
{
	var name Name;
	var string Path;
};

/** An EW material's textures, for its XCOM 2 stand-in; Kind picks the parent. */
struct LWX2Look
{
	var string Material;
	var name Kind;
	var string Diffuse;
	var string Normal;
	/** For the cut-out kinds: the diffuse's alpha in green and blue, which XCOM 2's cut-out parents read (mask-textures.ts). */
	var string Mask;
};

struct LWX2Standin
{
	var string Material;
	var MaterialInterface Standin;
};

/**
 * XCOM 2 cannot draw EW's materials (their shaders are not in its caches and the game does
 * not compile them), so each is replaced by an instance of one of XCOM 2's parents, by its
 * kind, given the EW material's textures. Empty: the EW materials are kept.
 */
var config string PropParent;
var config string FoliageParent;
/** The parent for EW's cut-out materials (tree cards, signs, fences, road paint), given the look's mask as its Masks. */
var config string MaskedParent;
var config string AlienParent;
/** Scalars set on every stand-in (SpecularScale 0: the parents' placeholder mask made EW's surfaces glossy and grey). */
var config array<LWX2Scalar> StandinScalars;
/** Textures set on every stand-in (Masks white: the parents' own value for "no mask"; their placeholder darkened everything). */
var config array<LWX2TextureParam> StandinTextures;
/** EW's alien pods (lw-missions.md, step 2): where its aliens stand, the commander's pod, how many. */
/** A place of EW's meld canisters (XComMeldContainerSpawnPoint; lw-loot.md): its drop zone's group, the turn it is gone, hard or easy. */
struct LWX2Meld
{
	var vector Loc;
	var int Group;
	var int Turns;
	var bool Hard;
};
struct LWX2Pod
{
	var vector Loc;
	var bool Commander;
	var int Min;
	var int Max;
	/** The sub-level it is in (Stream, EWI: the abduction variant, CNH); Abduction: the map's own abduction pods; none: the map's own. */
	var name Level;
};
/**
 * EW's lights (lw-missions.md, step 2): baked into its lightmaps, which XCOM 2 cannot use, so each is spawned as
 * a movable light. Kind: Point, Spot, Sun (its directional light), Sky. Unreal's units throughout.
 */
struct LWX2Light
{
	var name Kind;
	var vector Loc;
	var rotator Rot;
	var float Radius;
	var float Brightness;
	var color Color;
	var float Falloff;
	var float Inner;
	var float Outer;
	var float Lower;
};
/** Each light's brightness times this (EW's lightmaps added bounced light the movable lights do not). */
var config float LightScale;
/** Which kinds are placed (the mission's own sun and sky light the map too). */
var config array<name> LightKinds;

/** One of Long War's maps for its missions (its DefaultMaps.ini): the kind (Abduction, Crash, Landed, Terror), the ship. */
struct LWX2MapChoice
{
	var string Name;
	var string Family;
	var name Kind;
	var int Ship;
	var bool Night;
};
var config array<LWX2MapChoice> Maps;
/** The converted map a quick launch places (no campaign to choose one). */
var config string DefaultMap;
/** For development: this converted map for every Long War mission, whatever its kind ("": Long War's list decides). */
var config string ForceMap;

/** The mission's converted EW map: a Long War mission's choice (XComGameState_LWStrategy.PendingEWMap, "" for none), else DefaultMap. */
static function string MapName()
{
	local XComGameState_LWStrategy S;
	local XComGameState_BattleData Battle;
	local WorldInfo W;

	// In a mission on an EW map's own plot (LWX2_<map>): that map, whatever started the mission (the campaign's first
	// mission is XCOM 2's, before Long War's Geoscape exists).
	W = class'WorldInfo'.static.GetWorldInfo();
	if (W != none && XComTacticalGRI(W.GRI) != none)
	{
		Battle = XComGameState_BattleData(`XCOMHISTORY.GetSingleGameStateObjectForClass(class'XComGameState_BattleData'));
		if (Battle != none && Left(Battle.MapData.PlotMapName, 5) ~= "LWX2_" && !(Battle.MapData.PlotMapName ~= "LWX2_EWPlotTemplate"))
			return Mid(Battle.MapData.PlotMapName, 5);
	}
	S = class'XComGameState_LWStrategy'.static.Get();
	return (S != none && S.PendingKind != 0) ? S.PendingEWMap : default.DefaultMap;
}

/** The mission's converted EW map's data (empty when there is none). */
static function LWX2EWMapData Map()
{
	local string Wanted;
	local LWX2EWMapData Data;

	// Made once per map and found again by its name (its config read once: a map's section is thousands of lines).
	Wanted = MapName() != "" ? MapName() : "LWX2NoMap";
	Data = LWX2EWMapData(FindObject("Transient." $ Wanted, class'LWX2EWMapData'));
	if (Data == none)
		Data = new(none, Wanted) class'LWX2EWMapData';
	return Data;
}

/** Whether this mission is played on a converted EW map: the switch on, and the mission's map converted on this machine. */
static function bool HasMap()
{
	return class'UIScreenListener_LongWarX2Tactical'.default.PlaceEWMapWhole && Map().Pieces.Length > 0;
}

/** Long War's map kind for the port's mission kind (1 crash site, 2 landed UFO, 3 abduction, 4 terror). */
static function name KindFor(int Kind)
{
	switch (Kind)
	{
		case 1: return 'Crash';
		case 2: return 'Landed';
		case 3: return 'Abduction';
		case 4: return 'Terror';
	}
	return '';
}

/** The converted maps on this machine (their sections in XComLWX2EWMap.ini). */
static function array<string> ConvertedMaps()
{
	local array<string> Sections, Names;
	local string Section;

	GetPerObjectConfigSections(class'LWX2EWMapData', Sections);
	foreach Sections(Section)
		Names.AddItem(Left(Section, InStr(Section, " ")));
	return Names;
}

/**
 * A converted map for Long War's mission kind (and ship, for a crash or a landed UFO), at random among those Long War
 * lists for it; "" when this machine has none converted. A ship without a map of its own takes any of the kind.
 */
/**
 * Whether the mission is on the EW map's own plot (LWX2_<map>, written by tools/convert/ew-plot.ts): its geometry, lights
 * and spawns are in the plot, at EW's coordinates, and nothing is placed or hidden at run time.
 */
static function bool OnOwnPlot()
{
	local XComGameState_BattleData Battle;

	Battle = XComGameState_BattleData(`XCOMHISTORY.GetSingleGameStateObjectForClass(class'XComGameState_BattleData'));
	return Battle != none && MapName() != "" && Battle.MapData.PlotMapName ~= ("LWX2_" $ MapName());
}

static function string ChooseMap(name Kind, int Ship)
{
	local array<string> Converted, Fits, Any;
	local LWX2MapChoice M;

	Converted = ConvertedMaps();
	if (default.ForceMap != "" && Converted.Find(default.ForceMap) != INDEX_NONE)
		return default.ForceMap;
	foreach default.Maps(M)
	{
		if (M.Kind != Kind || Converted.Find(M.Name) == INDEX_NONE)
			continue;
		if (Any.Find(M.Name) == INDEX_NONE)
			Any.AddItem(M.Name);
		if ((Ship == 0 || M.Ship == Ship) && Fits.Find(M.Name) == INDEX_NONE)
			Fits.AddItem(M.Name);
	}
	if (Fits.Length > 0)
		return Fits[Rand(Fits.Length)];
	return Any.Length > 0 ? Any[Rand(Any.Length)] : "";
}

/** Spawns EW's lights (of LightKinds) moved by Shift; returns how many were placed. */
static function int PlaceLights(Actor Spawner, vector Shift)
{
	local LWX2Light L;
	local Light A;
	local int Count;
	local LWX2EWMapData D;

	D = Map();
	foreach D.Lights(L)
	{
		if (default.LightKinds.Find(L.Kind) == INDEX_NONE)
			continue;
		switch (L.Kind)
		{
			case 'Point': A = Spawner.Spawn(class'LWX2PointLight', , , L.Loc + Shift, L.Rot); break;
			case 'Spot': A = Spawner.Spawn(class'LWX2SpotLight', , , L.Loc + Shift, L.Rot); break;
			case 'Sun': A = Spawner.Spawn(class'LWX2SunLight', , , L.Loc + Shift, L.Rot); break;
			case 'Sky': A = Spawner.Spawn(class'LWX2SkyLight', , , L.Loc + Shift, L.Rot); break;
			default: A = none;
		}
		if (A == none || A.LightComponent == none)
			continue;
		if (PointLightComponent(A.LightComponent) != none)
		{
			PointLightComponent(A.LightComponent).Radius = L.Radius;
			PointLightComponent(A.LightComponent).FalloffExponent = L.Falloff;
		}
		if (SpotLightComponent(A.LightComponent) != none)
		{
			SpotLightComponent(A.LightComponent).InnerConeAngle = L.Inner;
			SpotLightComponent(A.LightComponent).OuterConeAngle = L.Outer;
		}
		A.LightComponent.SetLightProperties(L.Brightness * (default.LightScale > 0 ? default.LightScale : 1.0), L.Color);
		A.ReattachComponent(A.LightComponent);
		Count++;
	}
	`log("LongWarX2: EW map:" @ Count @ "of" @ D.Lights.Length @ "lights placed", , 'LongWarX2');
	return Count;
}

/** Spawns the pieces with their positions relative to Origin; returns how many were placed. */
static function int PlaceAll(Actor Spawner, vector Origin)
{
	local array<Actor> Placed;

	if (Map().Pieces.Length == 0)
		return 0;
	Place(Spawner, vect(0, 0, 0), 0, Origin, class'DynamicSMActor_Spawnable', Placed);
	return Placed.Length;
}

/**
 * Spawns the pieces within Radius of Center (all when Radius is 0), moved so Center lands
 * on At, as actors of the given class (a StaticMeshActor or a DynamicSMActor). With
 * bCollideInPlayOnly, pieces outside EW's play area (its backdrop) do not collide.
 */
static function Place(Actor Spawner, vector Center, float Radius, vector At, class<Actor> ActorClass, out array<Actor> Placed, optional bool bCollideInPlayOnly)
{
	local LWX2Piece P;
	local StaticMesh Mesh;
	local Actor A;
	local StaticMeshComponent Comp;
	local int Missing, i, Backdrop;
	local array<LWX2Standin> Standins;
	local MaterialInterface M;
	local LWX2EWMapData D;

	LoadPackage();
	D = Map();
	foreach D.Pieces(P)
	{
		if (Radius > 0 && VSize2D(P.Loc - Center) > Radius)
			continue;
		Mesh = StaticMesh(DynamicLoadObject(P.Mesh, class'StaticMesh', true));
		if (Mesh == none)
		{
			Missing++;
			continue;
		}
		A = Spawner.Spawn(ActorClass, , , At + P.Loc - Center, P.Rot);
		if (A == none)
			continue;
		if (DynamicSMActor(A) != none)
		{
			DynamicSMActor(A).SetStaticMesh(Mesh);
			Comp = DynamicSMActor(A).StaticMeshComponent;
			A.SetCollision(false, false);
		}
		else
		{
			Comp = StaticMeshActor(A).StaticMeshComponent;
			Comp.SetStaticMesh(Mesh);
		}
		A.SetDrawScale3D(P.Scale);
		// The backdrop does not collide: the huge pieces (the sky dome, the mountains: they would
		// enclose the map), and with bCollideInPlayOnly whatever is outside the play area.
		if (P.Backdrop || (bCollideInPlayOnly && (Abs(P.Loc.X - D.PlayCenter.X) > D.PlayExtent.X || Abs(P.Loc.Y - D.PlayCenter.Y) > D.PlayExtent.Y)))
		{
			A.SetCollision(false, false);
			Comp.SetBlockRigidBody(false);
			Comp.SetActorCollision(false, false);
			Comp.SetTraceBlocking(false, false); // the sky dome's collision box holds the whole map
			Backdrop++;
		}
		for (i = 0; i < P.Materials.Length; i++)
		{
			M = MaterialFor(P.Materials[i], A, Standins);
			if (M != none)
				Comp.SetMaterial(i, M);
		}
		Placed.AddItem(A);
	}
	`log("LongWarX2: EW map:" @ Placed.Length @ "pieces placed as" @ ActorClass.Name $ "," @ Missing @ "meshes not found;" @ Standins.Length @ "materials" $ ";" @ Backdrop @ "backdrop pieces without collision", , 'LongWarX2');
}

/** Loads the converted map package (any of its objects loads it whole: then its meshes are found by their paths). */
static function LoadPackage()
{
	local Object Loaded;

	Loaded = DynamicLoadObject(Map().MapPackage $ ".TheWorld", class'Object', true);
	`log("LongWarX2: EW map: package" @ Map().MapPackage @ (Loaded != none ? "loaded" : "not loaded (its meshes may still be found)"), , 'LongWarX2');
}

/** XCOM 2's cover points within Radius of At (for the experiment's log). */
static function int CountCover(XComWorldData World, vector At, float Radius)
{
	local array<XComCoverPoint> Points;

	World.GetCoverPoints(At, Radius, 256, Points);
	return Points.Length;
}

/** Of the 7x7 tiles around At, how many units cannot enter (a solid hull blocks them). */
static function int CountBlocked(XComWorldData World, vector At)
{
	local TTile Centre, T;
	local int dx, dy, n;

	Centre = World.GetTileCoordinatesFromPosition(At);
	for (dx = -3; dx <= 3; dx++)
		for (dy = -3; dy <= 3; dy++)
		{
			T = Centre;
			T.X += dx;
			T.Y += dy;
			if (!World.CanUnitsEnterTile(T))
				n++;
		}
	return n;
}

/** The material a slot gets: the EW material's XCOM 2 stand-in, made once; the EW material itself when it has none. */
static function MaterialInterface MaterialFor(string Path, Object InOuter, out array<LWX2Standin> Standins)
{
	local int k;
	local LWX2Look L;
	local LWX2Standin S;
	local string ParentPath;
	local Material Parent;
	local MaterialInstanceConstant MIC;
	local Texture T;

	if (Path == "")
		return none;
	k = Standins.Find('Material', Path);
	if (k != INDEX_NONE)
		return Standins[k].Standin;
	S.Material = Path;
	k = Map().Looks.Find('Material', Path);
	if (k != INDEX_NONE)
	{
		L = Map().Looks[k];
		ParentPath = L.Kind == 'Foliage' ? default.FoliageParent : (L.Kind == 'Alien' ? default.AlienParent : ((L.Kind == 'Masked' && default.MaskedParent != "") ? default.MaskedParent : default.PropParent));
	}
	if (ParentPath != "" && L.Diffuse != "")
	{
		Parent = Material(DynamicLoadObject(ParentPath, class'Material', true));
		if (Parent == none)
			`log("LongWarX2: EW map: parent material" @ ParentPath @ "not loaded; the EW material kept for" @ Path, , 'LongWarX2');
	}
	if (Parent != none)
	{
		MIC = new(InOuter) class'MaterialInstanceConstant';
		MIC.SetParent(Parent);
		for (k = 0; k < default.StandinScalars.Length; k++)
			MIC.SetScalarParameterValue(default.StandinScalars[k].Name, default.StandinScalars[k].Value);
		for (k = 0; k < default.StandinTextures.Length; k++)
		{
			T = Texture(DynamicLoadObject(default.StandinTextures[k].Path, class'Texture', true));
			if (T != none)
				MIC.SetTextureParameterValue(default.StandinTextures[k].Name, T);
		}
		T = Texture(DynamicLoadObject(L.Diffuse, class'Texture', true));
		if (T != none)
			MIC.SetTextureParameterValue('Diffuse', T);
		if (L.Mask != "")
		{
			T = Texture(DynamicLoadObject(L.Mask, class'Texture', true));
			if (T != none)
				MIC.SetTextureParameterValue('Masks', T);
		}
		if (L.Normal != "")
		{
			T = Texture(DynamicLoadObject(L.Normal, class'Texture', true));
			if (T != none)
				MIC.SetTextureParameterValue('Normal', T);
		}
		S.Standin = MIC;
	}
	else
		S.Standin = MaterialInterface(DynamicLoadObject(Path, class'MaterialInterface', true));
	Standins.AddItem(S);
	return S.Standin;
}
